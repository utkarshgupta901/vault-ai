# Copy to .env and fill in OPENAI_API_KEY. Everything else has working local defaults (see app/config.py).
OPENAI_API_KEY=
LLM_PROVIDER=openai            # "fake" runs without an OpenAI key (deterministic placeholder answers/embeddings)

# Models (env-only switches; prices in app/ai/pricing.py)
ANSWER_MODEL=gpt-6.1-sol
ANSWER_EFFORT=low
FAST_MODEL=gpt-6-luna
FAST_EFFORT=none
INSIGHTS_MODEL=gpt-6-luna
INSIGHTS_EFFORT=low
EMBED_MODEL=text-embedding-3-small

# Seeded API keys (local/demo only — set real secrets in the cloud)
SEED_DEMO_API_KEY=vault-demo-key
SEED_OTHER_API_KEY=vault-other-key
SEED_EVAL_API_KEY=vault-eval-key

# Host ports compose.yaml publishes (defaults: API 8000, Postgres 5433, Valkey 6380, S3 9200). To move one that is
# taken on this machine, EXPORT it in your shell; do not set it in this file: compose reads both (the shell wins), but
# make and the test suite read only the shell (`make smoke` -> localhost:$API_PORT, `make test` -> localhost:$PG_PORT
# and co.), so a port set only here would send them to the default ports. Example:
#   export API_PORT=18000 PG_PORT=15433 VALKEY_PORT=16380 S3_PORT=19200
#   make up && make test
# That moves the vault-ai stack itself (compose.yaml pins the project name): run from any checkout, it recreates the
# running vault-ai containers on the new ports. For a second, separate stack also export COMPOSE_PROJECT_NAME=<other>
# (its own containers and volumes; the vault-ai:latest image tag is still shared, see compose.yaml).

# Host-side tools (scripts/*.py, evals, `uv run python -m app.cli ...`) reach the stack through these URLs, so their
# ports must match the *_PORT values above. Inside compose they are overridden with service hostnames and ports.
DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5433/vault
BROKER_URL=redis://localhost:6380/0
CACHE_URL=redis://localhost:6380/1
S3_ENDPOINT_URL=http://localhost:9200
S3_ACCESS_KEY_ID=vaultlocal
S3_SECRET_ACCESS_KEY=vaultlocalsecret
S3_BUCKET=vault-uploads
